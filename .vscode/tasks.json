{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动网站预览",
      "type": "shell",
      "command": "bundle",
      "args": ["exec", "jekyll", "serve", "--livereload", "--host", "127.0.0.1", "--port", "4000"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}
